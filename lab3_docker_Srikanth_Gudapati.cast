[4788.566217, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment to look for templates in the current directory\r\u001b[10d"]
[4788.566634, "o", "\u001b[39m\u001b(B\u001b[menv = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[11d"]
[4788.567099, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m\"interface_template.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[13d"]
[4788.567521, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each router and generate config\r\u001b[14d"]
[4788.567972, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m]:\u001b[15;5H"]
[4788.568381, "o", "config = template.render(router=router)\u001b[16;5H"]
[4788.568828, "o", "filename = f\u001b(B\u001b[0;1m\u001b[32m\"{router['name']}_config.txt\"\u001b[17;5H"]
[4788.569235, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(filename, \u001b(B\u001b[0;1m\u001b[32m\"w\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m output_file:\u001b[18;9H"]
[4788.569673, "o", "output_file.write(config)\r\u001b[19d"]
[4788.570071, "o", "\u001b[?12l\u001b[?25h"]
[4788.5705, "o", "\u001b[?25l"]
[4788.571917, "o", "    "]
[4788.572362, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration for {router['name']} written to {filename}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[20d"]
[4788.572796, "o", "\u001b[?12l\u001b[?25h"]
[4791.852208, "o", "\u001b[?25l\u001b[56d\u001b(B\u001b[0;7mSave modified buffer?                                                                                               \u001b[57;1H Y\u001b(B\u001b[m Yes\u001b[K\r\u001b[58d\u001b(B\u001b[0;7m N\u001b(B\u001b[m No  \u001b[58;18H\u001b(B\u001b[0;7mC\u001b(B\u001b[m Cancel\u001b[K\u001b[56;23H\u001b[?12l\u001b[?25h"]
