[5320.397141, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[5320.398746, "o", "\u001b[2d"]
[5320.399179, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[5320.399583, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[5d"]
[5320.400026, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML data\r\u001b[6d"]
[5320.400428, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"devices.yaml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[7;5H"]
[5320.40086, "o", "data = yaml.safe_load(f)\r\u001b[9d"]
[5320.40126, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment to look for templates in the current directory\r\u001b[10d"]
[5320.40171, "o", "\u001b[39m\u001b(B\u001b[menv = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[11d"]
[5320.4021, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m\"interface_template.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[13d"]
[5320.402502, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each router and generate config\r\u001b[14d"]
[5320.402858, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m]:\u001b[15;5H"]
[5320.403296, "o", "config = template.render(router=router)\u001b[16;5H"]
[5320.40371, "o", "filename = f\u001b(B\u001b[0;1m\u001b[32m\"{router['name']}_config.txt\"\u001b[17;5H"]
