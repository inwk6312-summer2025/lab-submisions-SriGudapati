[4736.895528, "o", "import yaml\r\n"]
[4736.896096, "o", "\r\n# Set up Jinja2 environment to look for templates in the current directory\r\nenv = Environment(loader=FileSystemLoader('.'))\r\n"]
[4736.897962, "o", "template = env.get_template(\"interface_template.j2\")\r\n"]
[4736.899056, "o", "\r\n"]
[4736.899519, "o", "# Loop through each router and generate config\r\nfor router in data['routers']:\r\n"]
[4736.900201, "o", "    config = template.render(router=router)\r\n    filename = f\"{router['name']}_config.txt\"\r\n    with open(filename, \"w\") as output_file:\r\n        output_file.write(config)\r\n    print(f\"Configuration for {router['name']} written to {filename}\")\r\n"]
[4737.127439, "o", "\r\n"]
[4737.128238, "o", "Command 'import' not found, but can be installed with:"]
[4737.128651, "o", "\r\n"]
[4737.129102, "o", "\r\n"]
[4737.129546, "o", "sudo apt install graphicsmagick-imagemagick-compat  # version 1.4+really1.3.35-1ubuntu0.1, or"]
[4737.129974, "o", "\r\n"]
[4737.130386, "o", "sudo apt install imagemagick-6.q16                  # version 8:6.9.10.23+dfsg-2.1ubuntu11.10"]
[4737.130796, "o", "\r\n"]
[4737.131173, "o", "sudo apt install imagemagick-6.q16hdri              # version 8:6.9.10.23+dfsg-2.1ubuntu11.10"]
