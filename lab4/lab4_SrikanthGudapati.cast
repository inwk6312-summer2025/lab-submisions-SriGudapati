[2378.688529, "o", "\u001b[?25l\u001b[1;107H"]
[2378.689579, "o", "\u001b(B\u001b[0;7mModified"]
[2378.690754, "o", "\u001b(B\u001b[m"]
[2378.6924, "o", "\r\u001b[2d"]
[2378.692813, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[4d"]
[2378.693261, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define the device information\r\u001b[5d"]
[2378.693677, "o", "\u001b[39m\u001b(B\u001b[mdevices = [{\u001b[6;5H"]
[2378.69412, "o", "\u001b(B\u001b[0;1m\u001b[32m\"device_type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"cisco_ios\"\u001b[39m\u001b(B\u001b[m,\r\u001b[56d"]
[2378.694529, "o", "\u001b[K\u001b[7d"]
[2378.695007, "o", "\u001b[?12l\u001b[?25h"]
[2378.695403, "o", "\u001b[?25l"]
[2378.708226, "o", "    "]
[2378.70884, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.101\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[31m # Replace with your actual device IP\u001b[8;5H"]
[2378.709358, "o", "\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m,\u001b[9;5H"]
[2378.709841, "o", "\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m,\u001b[10;5H"]
[2378.710349, "o", "\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"22\"\u001b[39m\u001b(B\u001b[m,\r\u001b[11d"]
[2378.710799, "o", "}]\r\u001b[13d"]
[2378.711236, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configuration commands to add Loopback interface\r\u001b[14d"]
[2378.711648, "o", "\u001b[39m\u001b(B\u001b[mloopback_config = [\u001b[15;5H"]
[2378.712077, "o", "\u001b(B\u001b[0;1m\u001b[32m\"interface Loopback10\"\u001b[39m\u001b(B\u001b[m,\u001b[16;5H"]
[2378.712492, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description Loopback interface added via Netmiko\"\u001b[39m\u001b(B\u001b[m,\u001b[17;5H"]
[2378.712952, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip address 10.10.10.10 255.255.255.255\"\u001b[39m\u001b(B\u001b[m,\u001b[18;5H"]
[2378.713354, "o", "\u001b(B\u001b[0;1m\u001b[32m\"no shutdown\"\r\u001b[19d"]
[2378.713766, "o", "\u001b[39m\u001b(B\u001b[m]\u001b[21d\b"]
[2378.714188, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop over devices and push configuration\r\u001b[22d"]
[2378.714635, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[23;5H"]
[2378.715093, "o", "net_connect = Netmiko(**device)\u001b[24;5H"]
[2378.715514, "o", "output = net_connect.send_config_set(loopback_config)\u001b[25;5H"]
