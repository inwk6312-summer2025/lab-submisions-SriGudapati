[2343.389451, "o", "\u001b[2d"]
[2343.389903, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[4d"]
[2343.390363, "o", "devices = [{\u001b(B\u001b[0;1m\u001b[32m\"device_type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"cisco_ios\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.101\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"por\u001b[39m\u001b(B\u001b[0;7m>\u001b[6;1H"]
[2343.390884, "o", "\u001b(B\u001b[mdescription_config = [\u001b(B\u001b[0;1m\u001b[32m\"interface GigabitEthernet3\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"description Description set with Netmiko\"\u001b[39m\u001b(B\u001b[m]\r\u001b[8d"]
[2343.391301, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[9;5H"]
[2343.391751, "o", "net_connect = Netmiko(**device)\u001b[10;5H"]
