[3939.959486, "o", "\u001b(B\u001b[m{\u001b(B\u001b[0;1m\u001b[32m\"device_type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"cisco_ios\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.104\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"22\u001b[39m\u001b(B\u001b[0;7m>\u001b[10;1H"]
[3939.959926, "o", "\u001b(B\u001b[m]\u001b[12d\b"]
[3939.960391, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through all routers and print interface descriptions\r\u001b[13d"]
[3939.960819, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m routers:\u001b[14;5H"]
[3939.961277, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n[+] Connecting to {device['ip']}\"\u001b[39m\u001b(B\u001b[m)\u001b[15;5H"]
