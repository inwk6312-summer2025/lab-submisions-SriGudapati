[2037.508882, "o", "\u001b[1;107H"]
[2037.510226, "o", "\u001b(B\u001b[0;7mModified\u001b(B\u001b[m\r\u001b[2d"]
[2037.51098, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[56d"]
[2037.511406, "o", "\u001b[K\u001b[3d"]
[2037.511774, "o", "\u001b[?12l\u001b[?25h"]
[2037.512201, "o", "\u001b[?25l"]
[2037.522394, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[2037.522913, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[6d"]
[2037.523329, "o", "hosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[7d"]
[2037.523767, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[9d"]
[2037.524178, "o", "env = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, autoescape=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[2037.524606, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
[2037.525023, "o", "loopback_config = template.render(data=interfaces)\r\u001b[13d"]
[2037.525456, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\u001b[14;5H"]
[2037.525872, "o", "net_connect = Netmiko(host=host[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m], username=host[\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m], password=host[\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m], port=host[\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[0;7m>\u001b[15;5H"]
[2037.526329, "o", "\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Logged into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[16;5H"]
[2037.526741, "o", "output = net_connect.send_config_set(loopback_config.split(\u001b(B\u001b[0;1m\u001b[32m\"\\n\"\u001b[39m\u001b(B\u001b[m))\u001b[17;5H"]
[2037.527177, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Pushed config into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[18;5H"]
[2037.527581, "o", "net_connect.disconnect()\r\u001b[19d"]
[2037.528012, "o", "\u001b[?12l\u001b[?25h"]
[2038.742431, "o", "\u001b[?25l\u001b[56d"]
