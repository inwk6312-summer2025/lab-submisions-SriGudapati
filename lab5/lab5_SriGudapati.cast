[2147.69525, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load the YAML file\r\u001b[8d"]
[2147.695954, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"routers_config.yaml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[9;5H"]
[2147.696509, "o", "config = yaml.safe_load(f)\r\u001b[11d"]
[2147.696927, "o", "\u001b(B\u001b[0;1m\u001b[31m# RESTCONF Headers\r\u001b[12d"]
[2147.697302, "o", "\u001b[39m\u001b(B\u001b[mHEADERS = {\u001b[13;5H"]
[2147.697691, "o", "\u001b(B\u001b[0;1m\u001b[32m\"Content-Type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"application/vnd.yang.data+json\"\u001b[39m\u001b(B\u001b[m,\u001b[14;5H"]
[2147.698071, "o", "\u001b(B\u001b[0;1m\u001b[32m\"Accept\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"application/vnd.yang.data+json\"\r\u001b[15d"]
[2147.698455, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[16d\b"]
[2147.698753, "o", "AUTH = HTTPBasicAuth(\u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[2147.69907, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m configure_interface\u001b[39m\u001b(B\u001b[m(host, interface_name, ip, netmask):\u001b[19;5H"]
[2147.699422, "o", "url = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/interfaces/interface/{interface_name}\"\u001b[20;5H"]
[2147.6998, "o", "\u001b[39m\u001b(B\u001b[mdata = {\u001b[21;9H"]
[2147.700143, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[22;13H"]
[2147.700541, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface_name,\u001b[23;13H"]
[2147.700886, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured via script\"\u001b[39m\u001b(B\u001b[m,\u001b[24;13H"]
[2147.701295, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[25;13H"]
[2147.701627, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[26;13H"]
[2147.701981, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[27;17H"]
[2147.702341, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[28;21H"]
[2147.702716, "o", "{\u001b[29;25H"]
