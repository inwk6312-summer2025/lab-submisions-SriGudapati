[696.844924, "o", "\u001b(B\u001b[0;1m\u001b[31m# get_interfaces.py\r\u001b[3d"]
[696.845368, "o", "\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[4d"]
[696.845784, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[56d"]
[696.846182, "o", "\u001b[K\u001b[5d"]
[696.846623, "o", "\u001b[?12l\u001b[?25h"]
[696.847032, "o", "\u001b[?25l"]
[696.866257, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[6d"]
[696.866933, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[8d"]
[696.867369, "o", "\u001b(B\u001b[0;1m\u001b[31m# Logging setup\r\u001b[9d"]
[696.867847, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
[696.868285, "o", "\u001b(B\u001b[0;1m\u001b[31m# Device credentials and base URL\r\u001b[12d"]
[696.868747, "o", "\u001b[39m\u001b(B\u001b[mHOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[31m # Replace with R1 or your assigned device IP\r\u001b[13d"]
[696.869179, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[14d"]
[696.869635, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[15d"]
[696.87005, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = f\u001b(B\u001b[0;1m\u001b[32m'http://{HOST}/restconf/api/running/'\r\u001b[17d"]
[696.87046, "o", "\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(append_url):\u001b[18;5H"]
[696.870858, "o", "url = BASE_URL + append_url\u001b[19;5H"]
[696.871223, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[20;5H"]
[696.87162, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[22;5H"]
[696.872028, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[23;5H"]
[696.872404, "o", "response = requests.get(url, auth=auth, headers=headers)\u001b[25;5H"]
[696.872814, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\u001b[26;9H"]
[696.873228, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Request successful on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[27;9H"]
[696.873645, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m json.dumps(response.json(), sort_keys=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, indent=4)\u001b[28;5H"]
[696.874013, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[29d\b"]
[696.87446, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error encountered on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[30;9H"]
[696.874871, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m response.text\r\u001b[32d"]
[696.875329, "o", "\u001b(B\u001b[0;1m\u001b[31m# Call the function and print the output\r\u001b[33d"]
[696.875755, "o", "\u001b[39m\u001b(B\u001b[mprint(get_interfaces(\u001b(B\u001b[0;1m\u001b[32m'interfaces'\u001b[39m\u001b(B\u001b[m))\r\u001b[34d"]
