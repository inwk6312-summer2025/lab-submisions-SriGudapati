[2147.703436, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: netmask\u001b[31;21H"]
[2147.703797, "o", "}\u001b[32;17H"]
[2147.704192, "o", "]\u001b[33;13H"]
[2147.704541, "o", "},\u001b[34d\b\b"]
[2147.704914, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv6\"\u001b[39m\u001b(B\u001b[m: {}\u001b[35;9H"]
[2147.705338, "o", "}\u001b[36;5H"]
[2147.705716, "o", "}\u001b[37d\b"]
[2147.706117, "o", "response = requests.put(url, auth=AUTH, headers=HEADERS, data=json.dumps(data))\u001b[38;5H"]
[2147.70651, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[39;9H"]
[2147.706998, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Success: {host} - {interface_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[40;5H"]
