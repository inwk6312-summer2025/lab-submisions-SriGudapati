[2233.25293, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[2233.259003, "o", "\u001b[2d"]
[2233.261481, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[3d"]
[2233.26197, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[4d"]
[2233.262378, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[2233.262774, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[7d"]
[2233.263181, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load the YAML file\r\u001b[8d"]
[2233.263531, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"routers_config.yaml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[9;5H"]
[2233.263902, "o", "config = yaml.safe_load(f)\r\u001b[11d"]
[2233.264233, "o", "\u001b(B\u001b[0;1m\u001b[31m# RESTCONF Headers\r\u001b[12d"]
[2233.264594, "o", "\u001b[39m\u001b(B\u001b[mHEADERS = {\u001b[13;5H"]
[2233.264923, "o", "\u001b(B\u001b[0;1m\u001b[32m\"Content-Type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"application/vnd.yang.data+json\"\u001b[39m\u001b(B\u001b[m,\u001b[14;5H"]
[2233.265291, "o", "\u001b(B\u001b[0;1m\u001b[32m\"Accept\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"application/vnd.yang.data+json\"\r\u001b[15d"]
[2233.265646, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[16d\b"]
[2233.266049, "o", "AUTH = HTTPBasicAuth(\u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[2233.266467, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m configure_interface\u001b[39m\u001b(B\u001b[m(host, interface_name, ip, netmask):\u001b[19;5H"]
[2233.266857, "o", "url = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/interfaces/interface/{interface_name}\"\u001b[20;5H"]
[2233.267246, "o", "\u001b[39m\u001b(B\u001b[mdata = {\u001b[21;9H"]
[2233.267671, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[22;13H"]
[2233.268014, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface_name,\u001b[23;13H"]
[2233.268387, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured via script\"\u001b[39m\u001b(B\u001b[m,\u001b[24;13H"]
[2233.268727, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[25;13H"]
[2233.269045, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[26;13H"]
[2233.269405, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[27;17H"]
[2233.269715, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[28;21H"]
[2233.270058, "o", "{\u001b[29;25H"]
[2233.270372, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: ip,\u001b[30;25H"]
[2233.270707, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: netmask\u001b[31;21H"]
[2233.271048, "o", "}\u001b[32;17H"]
[2233.271399, "o", "]\u001b[33;13H"]
[2233.271763, "o", "},\u001b[34d\b\b"]
[2233.272159, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv6\"\u001b[39m\u001b(B\u001b[m: {}\u001b[35;9H"]
[2233.272515, "o", "}\u001b[36;5H"]
[2233.27286, "o", "}\u001b[37d\b"]
[2233.27319, "o", "response = requests.put(url, auth=AUTH, headers=HEADERS, data=json.dumps(data))\u001b[38;5H"]
[2233.273543, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[39;9H"]
[2233.273921, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Success: {host} - {interface_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[40;5H"]
[2233.274348, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[41d\b"]
[2233.274733, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Failed: {host} - {interface_name}, Status: {response.status_code}, Error: {response.text}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[43d"]
[2233.275154, "o", "\u001b(B\u001b[0;1m\u001b[31m# Iterate through routers and configure interfaces\r\u001b[44d"]
[2233.275558, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router, info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config[\u001b(B\u001b[0;1m\u001b[32m\"routers\"\u001b[39m\u001b(B\u001b[m].items():\u001b[45;5H"]
[2233.275982, "o", "host = info[\u001b(B\u001b[0;1m\u001b[32m\"management_ip\"\u001b[39m\u001b(B\u001b[m]\u001b[46;5H"]
[2233.276356, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m iface, settings \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m info[\u001b(B\u001b[0;1m\u001b[32m\"interfaces\"\u001b[39m\u001b(B\u001b[m].items():\u001b[47;9H"]
[2233.276799, "o", "configure_interface(host, f\u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet{iface.split('/')[1]}\"\u001b[39m\u001b(B\u001b[m, settings[\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m], settings[\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m])\r\u001b[2d"]
[2233.27704, "o", "\u001b[?12l\u001b[?25h"]
