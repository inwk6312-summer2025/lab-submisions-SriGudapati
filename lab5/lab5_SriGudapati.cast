[2149.783684, "o", "(venv) \u001b]0;student@6312vm-csr20: ~/Desktop/restconf-lab/yang-models\u0007student@6312vm-csr20:~/Desktop/restconf-lab/yang-models$ "]
[2151.652065, "o", "p"]
[2152.179014, "o", "y"]
[2152.403478, "o", "t"]
