[727.56475, "o", "\u001b[?25l"]
[727.586093, "o", "\u001b[8d"]
[727.586773, "o", "\u001b(B\u001b[0;1m\u001b[31m# Logging setup\r\u001b[9d"]
[727.587415, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
[727.587848, "o", "\u001b(B\u001b[0;1m\u001b[31m# Device credentials and base URL\r\u001b[12d"]
[727.588275, "o", "\u001b[39m\u001b(B\u001b[mHOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[31m # Replace with R1 or your assigned device IP\r\u001b[13d"]
[727.588737, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[14d"]
[727.589193, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[15d"]
[727.589641, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = f\u001b(B\u001b[0;1m\u001b[32m'http://{HOST}/restconf/api/running/'\r\u001b[17d"]
[727.590054, "o", "\u001b[36mdef\u001b[34m get_interface\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\u001b[18;5H"]
[727.590472, "o", "url = BASE_URL + append_url + interface_name\u001b[19;5H"]
[727.590853, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[20;5H"]
[727.591263, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[21;5H"]
[727.591666, "o", "params = {\u001b(B\u001b[0;1m\u001b[32m'deep'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m} \u001b(B\u001b[0;1m\u001b[31m # Optional: use ?deep or ?shallow or ?verbose\u001b[23;5H"]
[727.59206, "o", "\u001b[39m\u001b(B\u001b[mlogging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[24;5H"]
[727.592451, "o", "response = requests.get(url, auth=auth, headers=headers, params=params)\u001b[26;5H"]
[727.592856, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\u001b[27;9H"]
[727.593248, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Request successful on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[28;9H"]
[727.593682, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m json.dumps(response.json(), sort_keys=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, indent=4)\u001b[29;5H"]
[727.594049, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[30d\b"]
[727.594459, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error encountered on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[31;9H"]
[727.594884, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m response.text\r\u001b[33d"]
[727.595272, "o", "\u001b(B\u001b[0;1m\u001b[31m# Call the function and print the output\r\u001b[34d"]
[727.595708, "o", "\u001b[39m\u001b(B\u001b[mprint(get_interface(\u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet1?verbose\"\u001b[39m\u001b(B\u001b[m))\r\u001b[35d"]
