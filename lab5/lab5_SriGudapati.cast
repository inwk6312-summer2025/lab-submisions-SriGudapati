[460.174451, "o", "\r\n              +--rw description?      string\r\n\r\n"]
[460.174798, "o", "  augment /if:interfaces-state/if:interface:\r\n    +--ro routing-instance?   string"]
[460.17605, "o", "\r\n\r\n  rpcs:\r\n    +---x fib-route\r\n"]
