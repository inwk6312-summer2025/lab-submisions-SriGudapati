[829.191076, "o", "\u001b[39m\u001b(B\u001b[mHOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[31m # Use the actual router IP (e.g., R1 or R2)\r\u001b[14d"]
[829.191503, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[15d"]
[829.191967, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[16d"]
[829.192401, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = f\u001b(B\u001b[0;1m\u001b[32m'http://{HOST}/restconf/api/running/'\r\u001b[18d"]
