[2147.657985, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[56d"]
