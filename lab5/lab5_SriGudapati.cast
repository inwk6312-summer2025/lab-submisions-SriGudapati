[2178.946121, "o", "import requests"]
[2178.947841, "o", "\r\n"]
[2178.948201, "o", "import yaml\r\nfrom requests.auth import HTTPBasicAuth\r\n\r\n# Load the YAML file\r\nwith open(\"routers_config.yaml\") as f:\r\n    config = yaml.safe_load(f)\r\n\r\n# RESTCONF Headers\r\n"]
[2178.948854, "o", "HEADERS = {\r\n"]
[2178.949119, "o", "    \"Content-Type\": \"application/vnd.yang.data+json\",\r\n"]
[2178.949356, "o", "    \"Accept\": \"application/vnd.yang.data+json\"\r\n"]
[2178.950003, "o", "}\r\nAUTH = HTTPBasicAuth(\"student\", \"Meilab123\")\r\n\r\ndef configure_interface(host, interface_name, ip, netmask):\r\n    url = f\"http://{host}/restconf/api/running/interfaces/interface/{interface_name}\"\r\n    data = {\r\n        \"ietf-interfaces:interface\": {\r\n"]
[2178.950485, "o", "            \"name\": interface_name,\r\n            \"description\": \"Configured via script\",\r\n            \"type\": \"iana-if-type:ethernetCsmacd\",\r\n            \"enabled\": True,\r\n            \"ietf-ip:ipv4\": {\r\n                \"address\": [\r\n                    {\r\n                        \"ip\": ip,\r\n"]
[2178.951287, "o", "                        \"netmask\": netmask\r\n                    }\r\n                ]\r\n            },\r\n            \"ietf-ip:ipv6\": {}\r\n        }\r\n    }\r\n    response = requests.put(url, auth=AUTH, headers=HEADERS, data=json.dumps(data))\r\n    if response.status_code == 204:\r\n        print(f\"Success: {host} - {interface_name}\")\r\n    else:\r\n        print(f\"Failed: {host} - {interface_name}, Status: {response.status_code}, Error: {response.text}\")\r\n\r\n# Iterate through routers and configure interfaces\r\nfor router, info in config[\"routers\"].items():\r\n    host = info[\"management_ip\"]\r\n    for iface, settings in info[\"interfaces\"].items():\r\n        configure_interface(host, f\"GigabitEthernet{iface.split('/')[1]}\", settings[\"ip\"], settings[\"netmask\"])\r\n"]
