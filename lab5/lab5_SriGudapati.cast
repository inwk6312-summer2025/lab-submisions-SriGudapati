[460.178982, "o", "\r\n             |        +--ro special-next-hop?     enumeration"]
[460.17935, "o", "\r\n             +--ro source-protocol    identityref\r\n             +--ro active?            empty"]
[460.183332, "o", "\r\n             +--ro last-updated?      yang:date-and-time\r\n"]
