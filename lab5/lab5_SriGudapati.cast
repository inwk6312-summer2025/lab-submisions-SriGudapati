[558.743488, "o", "\u001b[?25l"]
[558.758633, "o", "\u001b[39;49m\u001b(B\u001b[m\u001b[H\u001b[2J"]
[558.759371, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                         New Buffer                                                   \u001b[1;115H"]
[558.759786, "o", "\u001b(B\u001b[m"]
[558.760167, "o", "\u001b[56;34H"]
[558.760668, "o", "\u001b(B\u001b[0;7m[ Welcome to nano.  For basic help, type Ctrl+G. ]"]
[558.761076, "o", "\u001b(B\u001b[m\r\u001b[57d"]
[558.761364, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[558.762073, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[558.7624, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[558.762803, "o", "\u001b[2d"]
[558.763042, "o", "\u001b[39;49m\u001b(B\u001b[m"]
[558.76371, "o", "\u001b[?12l\u001b[?25h"]
[562.394088, "o", "\u001b[?25l\u001b[1;107H"]
[562.395391, "o", "\u001b(B\u001b[0;7mModified"]
[562.396325, "o", "\u001b(B\u001b[m\r\u001b[2d"]
[562.397481, "o", "\u001b[36m# get_interfaces.py\r\u001b[3d"]
[562.397932, "o", "\u001b[39m\u001b(B\u001b[mimport logging\r\u001b[56d"]
[562.398415, "o", "\u001b[K\u001b[4d"]
[562.4011, "o", "\u001b[?12l\u001b[?25h\u001b[?25l"]
[562.407188, "o", "import requests\r\u001b[5d"]
[562.407725, "o", "from requests.auth import HTTPBasicAuth\r\u001b[6d"]
[562.408114, "o", "import json\r\u001b[8d"]
[562.408552, "o", "\u001b[36m# Logging setup\r\u001b[9d"]
[562.408945, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format='%(name)s - %(levelname)s - %(message)s')\r\u001b[11d"]
[562.40939, "o", "\u001b[36m# Device credentials and base URL\r\u001b[12d"]
[562.40978, "o", "\u001b[39m\u001b(B\u001b[mHOST = '192.168.1.101'  # Replace with R1 or your assigned device IP\r\u001b[13d"]
[562.410203, "o", "USER = 'student'\r\u001b[14d"]
[562.410586, "o", "PASS = 'Meilab123'\r\u001b[15d"]
[562.411023, "o", "BASE_URL = f'http://{HOST}/restconf/api/running/'\r\u001b[17d"]
[562.411403, "o", "def get_interfaces(append_url):\u001b[18;5H"]
[562.411821, "o", "url = BASE_URL + append_url\u001b[19;5H"]
[562.412205, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[20;5H"]
[562.412628, "o", "headers = {'Accept': 'application/vnd.yang.data+json'}\u001b[22;5H"]
[562.413063, "o", "logging.info(f\"URL ==> {url}\")\u001b[23;5H"]
[562.413456, "o", "response = requests.get(url, auth=auth, headers=headers)\u001b[25;5H"]
[562.413853, "o", "if response.status_code == 200:\u001b[26;9H"]
[562.414277, "o", "logging.info(f\"Request successful on {HOST}, Code: {response.status_code}\")\u001b[27;9H"]
[562.414872, "o", "return json.dumps(response.json(), sort_keys=True, indent=4)\u001b[28;5H"]
[562.415266, "o", "else:\u001b[29d\b"]
[562.41566, "o", "logging.error(f\"Error encountered on {HOST}, Code: {response.status_code}\")\u001b[30;9H"]
[562.416081, "o", "return response.text\r\u001b[32d"]
[562.416502, "o", "\u001b[36m# Call the function and print the output\r\u001b[33d"]
[562.416892, "o", "\u001b[39m\u001b(B\u001b[mprint(get_interfaces('interfaces'))\r\u001b[34d"]
[562.417322, "o", "\u001b[?12l\u001b[?25h"]
